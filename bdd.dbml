// =====================================================================
//  Shopify Automation — Base de données  (édition BO SaaS)
//  À coller dans https://dbdiagram.io/home  (format DBML)
//
//  PRINCIPE : Shopify est la SOURCE DE VÉRITÉ du catalogue (produits,
//  collections, menus, politiques, images, avis/metaobjects). Le BO ne
//  fait qu'orchestrer via API → on ne duplique PAS ces données en base.
//  On stocke uniquement ce qui est À NOUS : comptes, boutiques connectées,
//  réglages des features, jobs, crédits/paiements, et un journal d'audit.
//
//  - config.json = 1 fichier par boutique → 1 colonne `config` (jsonb) sur stores.
//  - Contenu généré par l'IA = preview temporaire (jsonb) sur feature_runs,
//    puis injecté dans Shopify et jeté (pas de tables de contenu).
//  - PK en uuid (gen_random_uuid()) sauf `migrations` (convention ORM).
// =====================================================================


// ─────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────

Enum user_role_enum {
  admin
  user
}

Enum feature_enum {
  setup
  seo_boost
  fiche_produit
  fond_studio
  normalisation
  reviews
  seo_images
  collections
  politiques
  transfert
  menus
  rebrand
}

Enum run_status {
  pending
  running
  awaiting_validation   // preview généré, en attente de validation user
  completed
  failed
  interrupted
  cancelled
}

Enum credit_transaction_type {
  purchase    // + crédits (achat d'un pack, via webhook)
  consumption // - crédits (débité par un feature_run)
  refund      // + crédits (remboursement)
  bonus       // + crédits offerts (promo, parrainage)
  adjustment  // +/- correction manuelle (support)
}

Enum payment_status {
  pending
  paid
  failed
  refunded
}


// ─────────────────────────────────────────────────────────────────────
//  0. AUTH & SÉCURITÉ
// ─────────────────────────────────────────────────────────────────────

Table user {
  id                            uuid              [pk, default: `gen_random_uuid()`]
  email                         varchar(255)      [unique, not null]
  password                      varchar(255)      [note: 'hash bcrypt/argon2']
  role                          user_role_enum
  permissions                   "text[]"          [default: '{}']
  first_name                    varchar
  last_name                     varchar
  phone_number                  varchar           [null]
  newsletter                    boolean           [default: false]
  terms_of_use_acceptation_date date              [null]
  stripe_customer_id            varchar           [null, note: 'cus_… — rattache l historique de paiement']
  email_verified                boolean           [default: false]
  billing_address               varchar           [null]
  billing_address_complement    varchar           [null]
  billing_city                  varchar           [null]
  billing_postal_code           varchar           [null]
  billing_country               varchar           [null]
  preferred_language            varchar(10)       [null]
  last_login_at                 timestamptz       [null]
  last_login_ip                 varchar(45)       [null, note: 'dernière IP de connexion (IPv4/IPv6)']
  created_at                    timestamptz       [default: `now()`]
  updated_at                    timestamptz       [default: `now()`]

  Note: 'Compte client du SaaS. Possède N boutiques + 1 wallet de crédits.'
}

Table user_token {
  id                uuid          [pk, default: `gen_random_uuid()`]
  user_id           uuid          [not null]
  value             varchar(255)  [unique, not null]
  can_be_refreshed  boolean
  token_type        varchar(255)  [note: 'access | refresh | email_verification | password_reset']
  created_at        timestamptz   [default: `now()`]
  updated_at        timestamptz   [default: `now()`]
  expiration_date   timestamptz

  Note: 'Jetons applicatifs (auth, refresh, vérif email, reset mdp). ON DELETE CASCADE.'
}
Ref: user_token.user_id > user.id [delete: cascade]

Table migrations {
  id         integer   [pk, increment, note: 'nextval(migrations_id_seq)']
  timestamp  bigint    [not null]
  name       varchar   [not null]

  Note: 'Historique des migrations (TypeORM/Knex…). Géré par l ORM.'
}

// Anti brute-force : compte les tentatives (login, reset mdp…) par cible +
// identifiant dans une fenêtre de temps → blocage si trop nombreuses.
Table rate_limit_attempt {
  id          uuid          [pk, default: `gen_random_uuid()`]
  target      varchar(255)  [not null, note: 'action limitée : login | password_reset | email_verification']
  identifier  varchar(128)  [not null, note: 'clé de regroupement : email ou IP']
  created_at  timestamptz   [default: `now()`]

  indexes {
    (target, identifier, created_at)
    created_at [note: 'purge des vieilles tentatives']
  }
  Note: 'Protège les endpoints publics d auth contre le brute-force.'
}

// JOURNAL D'AUDIT : trace toute action sensible → qui, quoi, d'où, quand.
// Sert à détecter/enquêter sur un compte piraté, un usage anormal, une fraude.
Table audit_log {
  id          uuid          [pk, default: `gen_random_uuid()`]
  user_id     uuid          [null, note: 'null si acteur inconnu (ex: login échoué sur email inexistant)']
  action      varchar       [not null, note: 'login | login_failed | logout | password_changed | email_changed | store_connected | store_token_updated | feature_run_started | credits_purchased | payment_failed | …']
  ip_address  varchar(45)   [note: 'IPv4/IPv6 de l acteur']
  user_agent  varchar       [note: 'navigateur/appareil']
  metadata    jsonb         [note: 'contexte libre : store_id, run_id, montant, ancienne/nouvelle valeur…']
  created_at  timestamptz   [default: `now()`]

  indexes {
    (user_id, created_at)
    action
    created_at
  }
  Note: 'Append-only. Ne jamais UPDATE/DELETE. Rétention conseillée : 1 an+.'
}
Ref: audit_log.user_id > user.id [delete: set null]


// ─────────────────────────────────────────────────────────────────────
//  1. BOUTIQUES  (connexion Shopify + réglages des features)
// ─────────────────────────────────────────────────────────────────────

Table stores {
  id            uuid         [pk, default: `gen_random_uuid()`]
  user_id       uuid         [not null, note: 'propriétaire']
  name          varchar      [not null, note: 'nom affiché']
  store_url     varchar      [not null, note: 'xxxx.myshopify.com']
  access_token  varchar      [not null, note: 'token OAuth Shopify — À CHIFFRER en base']
  config        jsonb        [note: 'ex config.json : réglages seo_boost, fiche_produit, fond_studio, normalisation, collections, menus, rebrand… 1 clé par feature']
  connected_at  timestamptz  [default: `now()`]
  created_at    timestamptz  [default: `now()`]
  updated_at    timestamptz

  indexes {
    (user_id, store_url) [unique]
  }
  Note: '1 boutique Shopify connectée. Le catalogue vit dans Shopify (fetch live via API), pas ici.'
}
Ref: stores.user_id > user.id [delete: cascade]

// Contexte IA rédigé par l'utilisateur (marketing, personas, réassurance).
// Réutilisé à chaque génération — pas dans Shopify → on le garde.
Table ai_context_file {
  id          uuid      [pk, default: `gen_random_uuid()`]
  store_id    uuid      [not null]
  kind        varchar   [not null, note: 'marketing | persona1 | persona2 | persona3 | reassurance']
  content     text
  updated_at  timestamptz

  indexes {
    (store_id, kind) [unique]
  }
  Note: 'Remplace stores/{boutique}/reviews/*.md.'
}
Ref: ai_context_file.store_id > stores.id [delete: cascade]


// ─────────────────────────────────────────────────────────────────────
//  2. JOBS  (exécutions de features : quoi, quand, combien de crédits)
// ─────────────────────────────────────────────────────────────────────

Table feature_runs {
  id                uuid          [pk, default: `gen_random_uuid()`]
  store_id          uuid          [not null]
  user_id           uuid          [not null, note: 'qui a lancé (dupliqué pour requêtes/audit rapides)']
  feature           feature_enum  [not null]
  status            run_status    [not null, default: 'pending']

  params            jsonb         [note: 'entrées du run : options, produits ciblés, boutique dest (transfert)…']
  progress          jsonb         [note: 'reprise : handles/ids déjà traités, last_index (remplace progress.json)']
  preview           jsonb         [note: 'contenu généré EN ATTENTE de validation ; vidé après injection Shopify']

  credits_estimated integer       [default: 0, note: 'crédits estimés avant lancement']
  credits_spent     integer       [default: 0, note: 'crédits réellement débités (détail dans credit_transaction)']

  // Coûts internes OpenAI (ta marge — pas facturé tel quel au client)
  openai_calls      integer       [default: 0]
  openai_tokens_in  integer       [default: 0]
  openai_tokens_out integer       [default: 0]
  cost_usd          decimal       [default: 0]

  started_at        timestamptz   [default: `now()`]
  finished_at       timestamptz
  error_message     text

  indexes {
    (store_id, started_at)
    (user_id, started_at)
    (feature, status)
  }
  Note: 'Un run = une feature lancée sur une boutique. Répond « quelle feature, quand, combien de crédits ».'
}
Ref: feature_runs.store_id > stores.id [delete: cascade]
Ref: feature_runs.user_id  > user.id   [delete: cascade]


// ─────────────────────────────────────────────────────────────────────
//  3. CRÉDITS & PAIEMENTS  (pay-as-you-go, Stripe one-time)
// ─────────────────────────────────────────────────────────────────────

// Barème : combien de crédits coûte chaque feature (par produit traité).
// Feature normale = 1 ; feature lourde = plus ; feature non-IA = 0.
Table feature_pricing {
  id                uuid          [pk, default: `gen_random_uuid()`]
  feature           feature_enum  [unique, not null]
  credits_per_unit  integer       [not null, default: 1, note: 'seo_boost=1, collections=2, reviews=1, fond_studio=2, menus/politiques/normalisation…=0']
  unit              varchar       [default: 'product']
  active            boolean       [default: true]
  updated_at        timestamptz

  Note: 'Barème de consommation, modifiable sans redéploiement.'
}

// Packs achetables (miroir des Prices Stripe one-time).
Table credit_pack {
  id                uuid          [pk, default: `gen_random_uuid()`]
  stripe_price_id   varchar       [unique, note: 'price_… (source de vérité du tarif)']
  stripe_product_id varchar       [note: 'prod_…']
  name              varchar       [not null, note: 'ex: Pack 252 crédits']
  credits           integer       [not null]
  price_cents       integer       [not null]
  currency          varchar(3)    [default: 'eur']
  active            boolean       [default: true]

  Note: 'Catalogue des packs. Tarif réel = Stripe ; ceci est un miroir d affichage.'
}

// Portefeuille : 1 par user. balance/total_* sont des CACHES ;
// la vérité = le ledger credit_transaction.
Table credit_wallet {
  id                uuid          [pk, default: `gen_random_uuid()`]
  user_id           uuid          [unique, not null]
  balance           integer       [default: 0, note: 'solde actuel = SUM(amount)']
  total_purchased   integer       [default: 0, note: 'cumul crédits achetés (affichage)']
  total_spent       integer       [default: 0, note: 'cumul crédits dépensés (affichage)']
  updated_at        timestamptz

  Note: 'Répond « combien acheté / dépensé / actuellement ».'
}
Ref: credit_wallet.user_id > user.id [delete: cascade]

// Achats one-time (miroir Stripe Checkout mode=payment).
Table payment {
  id                          uuid            [pk, default: `gen_random_uuid()`]
  user_id                     uuid            [not null]
  credit_pack_id              uuid            [note: 'pack acheté']
  stripe_checkout_session_id  varchar         [unique, note: 'cs_… — idempotence commande']
  stripe_payment_intent_id    varchar         [note: 'pi_…']
  amount_cents                integer         [not null, note: 'combien il a PAYÉ (en centimes)']
  currency                    varchar(3)      [default: 'eur']
  credits_granted             integer         [not null]
  status                      payment_status  [default: 'pending']
  created_at                  timestamptz     [default: `now()`]

  indexes {
    (user_id, created_at)
  }
  Note: 'Un achat de pack. paid via webhook → crédite le wallet.'
}
Ref: payment.user_id       > user.id [delete: cascade]
Ref: payment.credit_pack_id > credit_pack.id

// LEDGER append-only : chaque mouvement de crédits. Solde = SUM(amount).
Table credit_transaction {
  id            uuid                      [pk, default: `gen_random_uuid()`]
  wallet_id     uuid                      [not null]
  type          credit_transaction_type  [not null]
  amount        integer                   [not null, note: 'signé : + crédit, - débit']
  balance_after integer                   [note: 'solde après ce mouvement (audit)']
  payment_id    uuid                      [note: 'si purchase → l achat source']
  run_id        uuid                      [note: 'si consumption → le run qui a consommé']
  description   varchar
  created_at    timestamptz               [default: `now()`]

  indexes {
    (wallet_id, created_at)
    type
  }
  Note: 'Grand livre immuable. Ne jamais UPDATE/DELETE — on ajoute des lignes.'
}
Ref: credit_transaction.wallet_id  > credit_wallet.id [delete: cascade]
Ref: credit_transaction.payment_id > payment.id
Ref: credit_transaction.run_id     > feature_runs.id

// Journal des webhooks Stripe → idempotence (ne jamais traiter 2× le même).
Table stripe_event {
  id                uuid          [pk, default: `gen_random_uuid()`]
  stripe_event_id   varchar       [unique, not null, note: 'evt_… — clé d idempotence']
  type              varchar       [not null, note: 'checkout.session.completed | charge.refunded | …']
  payload           jsonb         [note: 'corps brut (debug/rejeu)']
  processed_at      timestamptz   [note: 'null tant que non traité']
  created_at        timestamptz   [default: `now()`]

  Note: 'On enregistre l event AVANT de le traiter ; si déjà présent → skip.'
}
